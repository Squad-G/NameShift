<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NameShift.Cmd\NameShift.Cmd.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\NameShift.Core.Tests\JpegBuilder.cs" Link="Support\JpegBuilder.cs" />
    <Compile Include="..\NameShift.Ui.Tests\Files\FakePhotoFile.cs" Link="Support\FakePhotoFile.cs" />
  </ItemGroup>
  <!-- The console exe is net48 only: the net48 test build copies NameShiftCmd.exe next to the tests. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <ProjectReference Include="..\..\src\NameShift.Cmd.Exe\NameShift.Cmd.Exe.csproj" />
  </ItemGroup>
</Project>
